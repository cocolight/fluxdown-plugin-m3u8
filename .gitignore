_build*.py
_build*.exe
_build*.cmd
*.build/
*.dist/
*.onefile-build/
_build_exe.build/

# Python 虚拟环境 / 缓存
.venv/
.ruff_cache/
.pytest_cache/

# 临时 / 日志
*.tmp
*.log

# 编辑器 / OS
.DS_Store
.idea/
.vscode/

# AI 工具数据（本地，不纳入版本控制）
.workbuddy/

