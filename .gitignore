# WorkBuddy 本地记忆（含个人隐私，不入库）
.workbuddy/

# 依赖
node_modules/

# 构建产物：发布包单独托管在 GitHub Release，不进版本库
*.fxplug
dist/
build/

# 比对工具的自检副本（PARITY_DIST 指向这里）
.mutant/

# 沙箱环境的安全删除暂存目录
.Trash-*/

# 临时构建脚本与 Nuitka 生成的启动器残留
_build*.py
_build*.exe
_build*.cmd

# Nuitka 中间产物
*.build/
*.dist/
*.onefile-build/
_build_exe.build/

# Python 缓存（adfilter 清洗服务）
__pycache__/
*.pyc
