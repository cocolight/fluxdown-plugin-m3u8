{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [],
    // ★ 只到 ES2022，不含 DOM —— QuickJS 沙箱里没有 URL / fetch / TextEncoder / setTimeout。
    //   这样任何 `new URL(...)`、`fetch(...)` 都会在编译期失败，而不是在装机后静默打挂解析。
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts"]
}
